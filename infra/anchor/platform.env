# Non-secret Anchor Platform settings. Secrets live in generated/platform.secrets.env (see setup.ts).
STELLAR_NETWORK_TYPE=horizon
STELLAR_NETWORK_HORIZON_URL=https://horizon-testnet.stellar.org
APP_LOGGING_REQUEST_LOGGER_ENABLED=true
LANGUAGES=en

EVENTS_ENABLED=true
EVENTS_QUEUE_TYPE=kafka
EVENTS_QUEUE_KAFKA_BOOTSTRAP_SERVER=kafka:29092
EVENT_PROCESSOR_CLIENT_STATUS_CALLBACK_ENABLED=true
EVENT_PROCESSOR_CALLBACK_API_REQUEST_ENABLED=false

CALLBACK_API_BASE_URL=http://anchor-business:8091/
PLATFORM_API_BASE_URL=http://platform:8085

DATA_TYPE=postgres
DATA_SERVER=anchor-db:5432
DATA_DATABASE=postgres
DATA_SCHEMA=anchor-platform
DATA_FLYWAY_ENABLED=true
SECRET_DATA_USERNAME=postgres
SECRET_DATA_PASSWORD=password

ASSETS_TYPE=file
ASSETS_VALUE=/generated/assets.yaml
CLIENTS_TYPE=file
CLIENTS_VALUE=/generated/clients.yaml

SEP1_ENABLED=true
SEP1_TOML_TYPE=file
SEP1_TOML_VALUE=/generated/stellar.toml

SEP10_ENABLED=true
SEP10_WEB_AUTH_DOMAIN=localhost:8080
SEP10_HOME_DOMAINS=localhost:8080

SEP24_ENABLED=true
SEP24_INTERACTIVE_URL_BASE_URL=http://localhost:8091/sep24/interactive
SEP24_MORE_INFO_URL_BASE_URL=http://localhost:8091/sep24/more_info
SEP24_KYC_FIELDS_FORWARDING_ENABLED=false

SEP38_ENABLED=true
